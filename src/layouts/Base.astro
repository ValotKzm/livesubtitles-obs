---
import { getAbsoluteLocaleUrl, getRelativeLocaleUrl } from 'astro:i18n';
import '@fontsource-variable/montserrat';
import '../styles/global.css';
import { getDictionary, links, localeNames, locales, type Locale } from '../i18n';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang={locale}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{t.meta.title}</title>
		<meta name="description" content={t.meta.description} />
		<link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
		<link rel="canonical" href={getAbsoluteLocaleUrl(locale)} />
		{locales.map((l) => <link rel="alternate" hreflang={l} href={getAbsoluteLocaleUrl(l)} />)}
		<link rel="alternate" hreflang="x-default" href={getAbsoluteLocaleUrl('en')} />
		<!-- Applique le thème choisi avant le premier affichage, pour éviter un flash. -->
		<script is:inline>
			try {
				const saved = localStorage.getItem('theme');
				if (saved === 'light' || saved === 'dark') document.documentElement.dataset.theme = saved;
			} catch {}
		</script>
	</head>
	<body class="font-sans antialiased">
		<a
			href="#main"
			class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded focus:bg-surface focus:px-3 focus:py-2"
		>
			{t.nav.skip}
		</a>
		<header class="sticky top-0 z-40 border-b border-line bg-bg/85 backdrop-blur">
			<div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-5 py-3 sm:px-8">
				<a href={getRelativeLocaleUrl(locale)} class="flex items-center gap-2.5 text-lg font-bold">
					<svg viewBox="0 0 32 32" class="size-7" aria-hidden="true">
						<rect width="32" height="32" rx="7" fill="#0a0f14"></rect>
						<rect x="6" y="18" width="20" height="3.5" rx="1.75" fill="#00e5ff"></rect>
						<rect x="9" y="24" width="14" height="3.5" rx="1.75" fill="#e8e8e8"></rect>
					</svg>
					LiveSubtitles
				</a>
				<div class="flex items-center gap-5 text-sm font-medium">
					<a href={links.repo} class="hidden underline-offset-4 hover:underline sm:inline">
						{t.nav.source}
					</a>
					<!-- Affiché par le script en bas de page : sans JavaScript, le thème suit le système. -->
					<button
						id="theme-toggle"
						type="button"
						hidden
						aria-label={t.nav.theme}
						title={t.nav.theme}
						class="rounded-full border border-line bg-surface p-2 text-muted hover:text-ink"
					>
						<svg
							viewBox="0 0 24 24"
							class="size-4"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round"
							aria-hidden="true"
						>
							<path class="icon-moon" d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"></path>
							<g class="icon-sun">
								<circle cx="12" cy="12" r="4"></circle>
								<path d="M12 2v2m0 16v2M2 12h2m16 0h2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
							</g>
						</svg>
					</button>
					<nav aria-label={t.nav.language}>
						<ul class="flex rounded-full border border-line bg-surface p-1">
							{
								locales.map((l) => (
									<li>
										<a
											href={getRelativeLocaleUrl(l)}
											lang={l}
											hreflang={l}
											aria-current={l === locale ? 'page' : undefined}
											class="block rounded-full px-3 py-1 text-muted hover:text-ink aria-[current=page]:bg-surface-2 aria-[current=page]:font-bold aria-[current=page]:text-ink"
										>
											{localeNames[l]}
										</a>
									</li>
								))
							}
						</ul>
					</nav>
				</div>
			</div>
		</header>
		<main id="main">
			<slot />
		</main>
		<footer class="border-t border-line">
			<div
				class="mx-auto flex max-w-6xl flex-col gap-2 px-5 py-8 text-sm text-muted sm:flex-row sm:justify-between sm:px-8"
			>
				<p>{t.footer.privacy}</p>
				<p><a href={links.license} class="underline underline-offset-4">{t.source.license}</a></p>
			</div>
		</footer>
		<script is:inline>
			{
				const root = document.documentElement;
				const button = document.getElementById('theme-toggle');
				button.hidden = false;
				button.addEventListener('click', () => {
					const dark =
						root.dataset.theme === 'dark' ||
						(!root.dataset.theme && matchMedia('(prefers-color-scheme: dark)').matches);
					root.dataset.theme = dark ? 'light' : 'dark';
					try {
						localStorage.setItem('theme', root.dataset.theme);
					} catch {}
				});
			}
		</script>
	</body>
</html>
