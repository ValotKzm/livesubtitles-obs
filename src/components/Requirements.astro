---
import Section from './Section.astro';
import type { Dictionary } from '../i18n';

interface Props {
	t: Dictionary['requirements'];
}

const { t } = Astro.props;
---

<Section id="requirements" title={t.title}>
	<dl class="grid gap-x-8 gap-y-4 sm:grid-cols-[auto_1fr]">
		{
			t.items.map((item) => (
				<div class="contents">
					<dt class="font-semibold">{item.label}</dt>
					<dd class="text-neutral-300">{item.value}</dd>
				</div>
			))
		}
	</dl>

	<h3 class="mt-10 text-xl font-semibold">{t.limitsTitle}</h3>
	<ul class="mt-4 list-disc space-y-2 pl-6 text-neutral-300">
		{t.limits.map((limit) => <li>{limit}</li>)}
	</ul>
</Section>
