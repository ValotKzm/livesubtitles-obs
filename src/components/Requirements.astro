---
import Section from './Section.astro';
import { links, type Dictionary } from '../i18n';

interface Props {
	t: Dictionary['requirements'];
}

const { t } = Astro.props;
---

<Section id="requirements" title={t.title}>
	<div class="grid gap-5 lg:grid-cols-2">
		<div class="card py-2">
			<dl class="divide-y divide-line">
				{
					t.items.map((item) => (
						<div class="grid gap-1 py-3 sm:grid-cols-[9rem_1fr] sm:gap-4">
							<dt class="font-bold">{item.label}</dt>
							<dd class="text-muted">{item.value}</dd>
						</div>
					))
				}
			</dl>
			<p class="border-t border-line pb-2 pt-4 text-muted">
				{t.upcoming}{' '}
				<a href={links.issues} class="font-semibold text-accent underline underline-offset-4">{t.upcomingLink}</a>
			</p>
		</div>

		<div class="card">
			<h3 class="text-xl font-bold">{t.limitsTitle}</h3>
			<ul class="mt-4 list-disc space-y-3 pl-5 text-muted marker:text-accent">
				{t.limits.map((limit) => <li>{limit}</li>)}
			</ul>
		</div>
	</div>
</Section>
