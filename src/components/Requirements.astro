---
import Section from './Section.astro';
import type { Dictionary } from '../i18n';

interface Props {
	t: Dictionary['requirements'];
}

const { t } = Astro.props;
---

<Section id="requirements" title={t.title}>
	<div class="grid gap-5 lg:grid-cols-2">
		<dl class="card divide-y divide-line py-2">
			{
				t.items.map((item) => (
					<div class="grid gap-1 py-3 sm:grid-cols-[9rem_1fr] sm:gap-4">
						<dt class="font-bold">{item.label}</dt>
						<dd class="text-muted">{item.value}</dd>
					</div>
				))
			}
		</dl>

		<div class="card">
			<h3 class="text-xl font-bold">{t.limitsTitle}</h3>
			<ul class="mt-4 list-disc space-y-3 pl-5 text-muted marker:text-accent">
				{t.limits.map((limit) => <li>{limit}</li>)}
			</ul>
		</div>
	</div>
</Section>
