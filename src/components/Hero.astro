---
import { links, type Dictionary } from '../i18n';

interface Props {
	t: Dictionary['hero'];
}

const { t } = Astro.props;
---

<section class="hero-glow">
	<div
		class="mx-auto grid max-w-6xl items-center gap-10 px-5 pb-14 pt-12 sm:px-8 sm:pt-16 lg:grid-cols-[1.15fr_1fr] lg:pb-20"
	>
		<div>
			<h1 class="enter text-4xl font-extrabold leading-tight tracking-tight sm:text-5xl">
				{t.title}
			</h1>
			<p class="enter mt-5 max-w-xl text-lg text-muted" style="--delay: 0.1s">{t.lead}</p>
			<div class="enter mt-8" style="--delay: 0.2s">
				<a
					id="download"
					href={links.download}
					class="inline-flex items-center gap-3 rounded-xl bg-cta px-6 py-3.5 text-lg font-bold text-cta-ink transition-colors hover:bg-cta-hover"
				>
					<svg
						viewBox="0 0 24 24"
						class="size-5"
						fill="none"
						stroke="currentColor"
						stroke-width="2.5"
						stroke-linecap="round"
						stroke-linejoin="round"
						aria-hidden="true"
					>
						<path d="M12 4v11m0 0-4.5-4.5M12 15l4.5-4.5M5 20h14"></path>
					</svg>
					{t.download}
				</a>
				<p class="mt-3 text-sm text-muted">{t.downloadNote}</p>
			</div>
		</div>

		<!-- Exemple illustratif : ce que dit le streamer, puis ce que lisent les viewers. -->
		<div class="enter card" style="--delay: 0.3s">
			<p class="text-xs font-bold uppercase tracking-widest text-muted">{t.example.spokenLabel}</p>
			<p class="mt-2 text-xl font-semibold" lang="fr">{t.example.spoken}</p>
			<div class="my-5 border-t border-line"></div>
			<p class="text-xs font-bold uppercase tracking-widest text-muted">
				{t.example.subtitleLabel}
			</p>
			<div class="mt-3 rounded-lg bg-surface-2 px-4 pb-4 pt-10 text-center">
				<p class="caption caption-in text-base sm:text-lg" lang="en">{t.example.subtitle}</p>
			</div>
		</div>
	</div>
</section>
