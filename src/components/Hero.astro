---
import { links, type Dictionary } from '../i18n';

interface Props {
	t: Dictionary['hero'];
}

const { t } = Astro.props;
---

<section class="mx-auto max-w-5xl px-6 pb-10 pt-12 sm:pt-20">
	<h1 class="max-w-3xl text-4xl font-bold tracking-tight sm:text-5xl">{t.title}</h1>
	<p class="mt-5 max-w-2xl text-lg text-neutral-300">{t.lead}</p>
	<div class="mt-8">
		<a
			id="download"
			href={links.download}
			class="inline-block rounded-lg bg-cyan-400 px-6 py-3 text-lg font-semibold text-neutral-950 hover:bg-cyan-300 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-cyan-300"
		>
			{t.download}
		</a>
		<p class="mt-3 text-sm text-neutral-400">{t.downloadNote}</p>
	</div>
</section>
