---
import Section from './Section.astro';
import { links, type Dictionary } from '../i18n';

interface Props {
	t: Dictionary['install'];
	download: string;
}

const { t, download } = Astro.props;
---

<Section id="install" title={t.title}>
	<ol class="grid gap-5 md:grid-cols-3">
		{
			t.steps.map((step, i) => (
				<li class="card">
					<span
						class="flex size-10 items-center justify-center rounded-full bg-cta text-lg font-extrabold text-cta-ink"
						aria-hidden="true"
					>
						{i + 1}
					</span>
					<h3 class="mt-4 text-xl font-bold">{step.title}</h3>
					<p class="mt-2 text-muted">{step.text}</p>
				</li>
			))
		}
	</ol>
	<p class="mt-6">
		<a href={links.download} class="link">{download}</a>
	</p>

	<div class="card mt-10 sm:p-8">
		<h3 class="text-xl font-bold">{t.useTitle}</h3>
		<ol class="mt-4 list-decimal space-y-2 pl-5 text-muted marker:font-bold marker:text-accent">
			{t.useSteps.map((step) => <li class="pl-1">{step}</li>)}
		</ol>
		<p class="mt-5 font-medium">{t.viewers}</p>
	</div>
</Section>
