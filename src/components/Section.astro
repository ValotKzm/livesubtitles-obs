---
interface Props {
	id: string;
	title: string;
}

const { id, title } = Astro.props;
---

<section id={id} aria-labelledby={`${id}-title`} class="mx-auto max-w-6xl px-5 py-14 sm:px-8 sm:py-20">
	<h2 id={`${id}-title`} class="reveal text-3xl font-extrabold tracking-tight sm:text-4xl">
		{title}
	</h2>
	<div class="reveal mt-8">
		<slot />
	</div>
</section>
