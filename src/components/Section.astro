---
interface Props {
	id: string;
	title: string;
}

const { id, title } = Astro.props;
---

<section id={id} aria-labelledby={`${id}-title`} class="mx-auto max-w-5xl px-6 py-14">
	<h2 id={`${id}-title`} class="text-2xl font-bold sm:text-3xl">{title}</h2>
	<div class="mt-6">
		<slot />
	</div>
</section>
