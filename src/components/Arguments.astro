---
import Section from './Section.astro';
import type { Dictionary } from '../i18n';

interface Props {
	t: Dictionary['arguments'];
}

const { t } = Astro.props;

// Une icône par argument, dans l'ordre du dictionnaire : gratuit, local, sans compte.
const icons = [
	'M12 21s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 11c0 5.6-7 10-7 10Z',
	'M4 5h16v10H4zM2 19h20M9 15v4m6-4v4',
	'M14.5 9.5a4 4 0 1 0-5 3.9V21l2.5-1.5L14.5 21v-2.5M4 4l16 16'
];
---

<Section id="why" title={t.title}>
	<ul class="grid gap-5 md:grid-cols-3">
		{
			t.items.map((item, i) => (
				<li class="card lift">
					<svg
						viewBox="0 0 24 24"
						class="size-9 text-accent"
						fill="none"
						stroke="currentColor"
						stroke-width="1.8"
						stroke-linecap="round"
						stroke-linejoin="round"
						aria-hidden="true"
					>
						<path d={icons[i]} />
					</svg>
					<h3 class="mt-4 text-xl font-bold">{item.title}</h3>
					<p class="mt-2 text-muted">{item.text}</p>
				</li>
			))
		}
	</ul>
</Section>
