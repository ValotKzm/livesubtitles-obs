---
import Section from './Section.astro';
import SubtitleSimulator from './SubtitleSimulator.tsx';
import type { Dictionary } from '../i18n';

interface Props {
	t: Dictionary['demo'];
}

const { t } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Section id="demo" title={t.title}>
	<figure>
		<img
			class="w-full rounded-2xl border border-line shadow-2xl shadow-black/20"
			src={`${base}/demo/demo-cartoon.svg`}
			alt={t.alt}
			width="1920"
			height="1080"
			loading="lazy"
		/>
		<figcaption class="mt-5 max-w-3xl text-lg text-muted">
			{t.caption}
			<span class="mt-1 block text-sm">{t.note}</span>
		</figcaption>
	</figure>

	<h3 class="mt-12 text-xl font-bold">{t.simulator.title}</h3>
	<div class="mt-4">
		<SubtitleSimulator client:visible t={t.simulator} />
		<noscript><p class="mt-3 text-sm text-muted">{t.simulator.noscript}</p></noscript>
	</div>
</Section>
