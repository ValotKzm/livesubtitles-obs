---
import Section from './Section.astro';
import { links, type Dictionary } from '../i18n';

interface Props {
	t: Dictionary['source'];
}

const { t } = Astro.props;
const items = [
	{ href: links.repo, label: t.repo },
	{ href: links.issues, label: t.issues },
	{ href: links.license, label: t.license },
	{ href: links.thirdParty, label: t.thirdParty }
];
---

<Section id="source" title={t.title}>
	<p class="text-lg text-muted">{t.text}</p>
	<ul class="mt-6 flex flex-wrap gap-3">
		{
			items.map((item) => (
				<li>
					<a
						href={item.href}
						class="lift inline-block rounded-full border border-line bg-surface px-5 py-2.5 font-semibold"
					>
						{item.label}
					</a>
				</li>
			))
		}
	</ul>
</Section>
